{
  "schema_version": 2,
  "description": "Fixed harness regression tasks for coding-for-me. Each run uses a fresh fixture copy and replays the task's oracle solution. Verification is declarative and runs in-process: fail_to_pass proves the task was completed, pass_to_pass proves nothing else was broken. Anything outside mutable_paths that changed during the run counts as a regression.",
  "tasks": [
    {
      "id": "readme_intro_locked",
      "prompt": "In the README fixture, replace the placeholder opening sentence with 'This fixture is a locked benchmark workspace.'",
      "fixture_repo": "tests/fixtures/bench_repo_readme",
      "allowed_tools": [
        "read_file",
        "patch_file"
      ],
      "step_budget": 4,
      "expected_artifact": "README.md opening sentence is locked benchmark workspace text",
      "mutable_paths": [
        "README.md"
      ],
      "checks": {
        "fail_to_pass": [
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "This fixture is a locked benchmark workspace."
          },
          {
            "kind": "file_not_contains",
            "path": "README.md",
            "text": "This is a placeholder benchmark fixture."
          }
        ],
        "pass_to_pass": [
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "# Bench Repo README"
          },
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "## Notes"
          },
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "- Placeholder note about the repo."
          },
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "- Placeholder note about the file layout."
          }
        ]
      },
      "category": "documentation"
    },
