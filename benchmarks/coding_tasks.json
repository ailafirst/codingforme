    {
      "id": "context_reduction_checkpoint",
      "prompt": "Report the current task state after prompt compression creates a checkpoint. Answer in text only and do not modify any file.",
      "fixture_repo": "tests/fixtures/bench_repo_readme",
      "allowed_tools": [
        "read_file"
      ],
      "step_budget": 2,
      "expected_artifact": "a checkpoint exists and no file changed",
      "mutable_paths": [],
      "checks": {
        "fail_to_pass": [
          {
            "kind": "report_truthy",
            "field": "checkpoint_id"
          },
          {
            "kind": "trace_event",
            "event": "checkpoint_created",
            "where": {
              "trigger": "context_reduction"
            }
          }
        ],
        "pass_to_pass": [
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "# Bench Repo README"
          },
          {
            "kind": "file_contains",
            "path": "README.md",
            "text": "This is a placeholder benchmark fixture."
          }
        ]
      },
      "category": "recovery",
      "setup": {
        "kind": "context_reduction",
        "history_count": 12,
        "note_count": 6,
        "total_budget": 450,
        "section_budgets": {
          "memory": 800,
          "relevant_memory": 800,
          "history": 2400
        },
        "section_floors": {
          "history": 100,
          "memory": 40,
          "relevant_memory": 40
        }
      }
    },
    {
      "id": "freshness_reanchor_resume",
      "prompt": "Resume the stale benchmark task and finish without trusting the old summary.",
      "fixture_repo": "tests/fixtures/bench_repo_patch",
      "allowed_tools": [
        "read_file"
      ],
      "step_budget": 3,
      "expected_artifact": "sample.txt exists after stale freshness recovery",
      "mutable_paths": [],
      "checks": {
        "fail_to_pass": [
          {
            "kind": "report_equals",
            "field": "resume_status",
            "value": "partial-stale"
          },
          {
            "kind": "trace_event",
            "event": "checkpoint_created",
            "where": {
              "trigger": "freshness_mismatch"
            }
          }
        ],
        "pass_to_pass": [
          {
            "kind": "file_contains",
            "path": "sample.txt",
            "text": "alpha\n"
          },
          {
            "kind": "file_contains",
            "path": "sample.txt",
            "text": "stale-updated"
          }
        ]
      },
      "category": "recovery",
      "setup": {
        "kind": "freshness_mismatch",
        "path": "sample.txt",
        "summary": "sample.txt: benchmark stale summary",
        "mutated_text": "alpha\nbeta\ngamma\nstale-updated\n"
      }
    },
